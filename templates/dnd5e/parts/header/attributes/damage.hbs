{{#if (or damage.length physical)}}
	<li class="attribute">
		<span class="attribute-wrapper">
			<h4 class="attribute-name">{{localize label}}</h4>
			{{#if damage.length}}
				<ul class="traits-list inline-list no-caps">
				{{~#each damage as |v|~}}
					<li class="trait-value">{{v}}</li>
				{{~/each~}}
				</ul>
			{{/if}}
			{{~#if physical~}}
				<span class="no-caps">{{#if damage.length}}{{localize "MOBLOKS5E.SemiColon"}} {{/if}}{{physical}}</span>
			{{~/if~}}
		</span>
	</li>
{{/if}}
